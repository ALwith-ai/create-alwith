{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ALwith app",
  "type": "object",
  "required": [
    "name",
    "productName",
    "identifier",
    "version",
    "icon",
    "languages",
    "window",
    "preset",
    "modules"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "productName": {
      "type": "string"
    },
    "identifier": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "en",
          "zh-CN"
        ]
      }
    },
    "preset": {
      "const": "chat"
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "window": {
      "type": "object",
      "required": [
        "width",
        "height",
        "minWidth",
        "minHeight"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "minWidth": {
          "type": "integer",
          "minimum": 1
        },
        "minHeight": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "template": {
      "type": "object"
    },
    "updates": {
      "type": "object",
      "description": "Signed auto update through the app's own GitHub Releases: the updater reads https://github.com/<github>/releases/latest/download/latest.json.",
      "required": [
        "github",
        "pubkey"
      ],
      "properties": {
        "github": {
          "type": "string",
          "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?/[A-Za-z0-9_.-]{1,100}$",
          "description": "owner/repo on github.com"
        },
        "pubkey": {
          "type": "string",
          "minLength": 64,
          "description": "Tauri updater public key (contents of the .key.pub file); the private key stays outside the project"
        }
      }
    }
  }
}
