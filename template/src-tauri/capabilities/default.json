{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: Runtime relay, logs, opening links, ALwith platform requests and the named store",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "alwith-desktop-shell:default",
    "log:default",
    "opener:default",
    "os:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://api.alwith.ai/service/**"
        },
        {
          "url": "https://api-dev.alwith.ai/service/**"
        }
      ]
    },
    "alwith-module-store:default",
    "alwith-auth-client:default"
  ]
}
